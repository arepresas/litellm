# Copy this file to .env and replace every CHANGE_ME value.
# .env is gitignored; this example is tracked. Never commit real secrets.

# ---------------------------------------------------------------------------
# Postgres
# ---------------------------------------------------------------------------
# User and database name are internal to Compose. Keep the defaults unless you
# also update docker-compose.yaml and any existing database volume.
POSTGRES_USER=litellm
POSTGRES_DB=litellm

# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME_WITH_OPENSSL_RAND_HEX_24

# ---------------------------------------------------------------------------
# LiteLLM
# ---------------------------------------------------------------------------
# Admin key for /key/*, /credentials, and the Admin UI.
# Generate with: openssl rand -hex 32
# Prefix the result with sk- .
LITELLM_MASTER_KEY=sk-CHANGE_ME_WITH_OPENSSL_RAND_HEX_32

# Encryption salt for credentials stored in Postgres.
# Generate with: openssl rand -hex 32
# Prefix the result with sk- .
# IMPORTANT: do not rotate this after the first boot; stored credentials would
# no longer decrypt. If unset, LiteLLM falls back to LITELLM_MASTER_KEY.
LITELLM_SALT_KEY=sk-CHANGE_ME_WITH_OPENSSL_RAND_HEX_32

# ---------------------------------------------------------------------------
# xAI OAuth (optional overrides)
# ---------------------------------------------------------------------------
# config.yaml sets use_xai_oauth: true, so XAI_API_KEY is NOT needed.
# Setting XAI_API_KEY would skip OAuth and break this setup.
#
# Defaults below match the bind mount in docker-compose.yaml. Leave them
# commented unless you also change that mount.
# XAI_OAUTH_TOKEN_DIR=/root/.config/litellm/xai_oauth
# XAI_OAUTH_AUTH_FILE=auth.json
# XAI_OAUTH_API_BASE=https://api.x.ai

# ---------------------------------------------------------------------------
# Not an env var
# ---------------------------------------------------------------------------
# The OpenCode virtual key is created through /key/generate and stored in the
# OpenCode auth store. It is not the master key and does not belong in .env.
